APP_NAME=DataCanvas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL — preencha as credenciais apenas no seu .env local.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=datacanvas
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DataCanvas — importação de planilhas
DATACANVAS_IMPORT_RETENTION_HOURS=24
DATACANVAS_PREVIEW_ROWS=25
DATACANVAS_MAX_FILE_BYTES=10485760
DATACANVAS_MAX_ROWS=10000
DATACANVAS_MAX_COLUMNS=100
DATACANVAS_MAX_CELLS=200000
DATACANVAS_MAX_PROCESSING_SECONDS=20
DATACANVAS_RATE_LIMIT_ENABLED=true
DATACANVAS_RATE_LIMIT_PER_MINUTE=5
DATACANVAS_RATE_LIMIT_PER_HOUR=20
DATACANVAS_LIVEWIRE_TEMP_RETENTION_HOURS=24

VITE_APP_NAME="${APP_NAME}"
